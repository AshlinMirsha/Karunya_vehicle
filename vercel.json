{
  "version": 2,
  "name": "karunya-bus-attendance",
  "cleanUrls": false,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/adminpanel",
      "destination": "https://kkbzofddkfusblyplnca.supabase.co/functions/v1/attendance-api?alert_path=adminpanel"
    },
    {
      "source": "/.env",
      "destination": "https://kkbzofddkfusblyplnca.supabase.co/functions/v1/attendance-api?alert_path=env"
    },
    {
      "source": "/students/allstudents.csv",
      "destination": "https://kkbzofddkfusblyplnca.supabase.co/functions/v1/attendance-api?alert_path=csv"
    },
    {
      "source": "/db_backup.sql",
      "destination": "https://kkbzofddkfusblyplnca.supabase.co/functions/v1/attendance-api?alert_path=sql"
    },
    {
      "source": "/",
      "destination": "/pages/index.html"
    },
    {
      "source": "/checkin",
      "destination": "/pages/checkin.html"
    },
    {
      "source": "/student",
      "destination": "/pages/student.html"
    },
    {
      "source": "/coordinator",
      "destination": "/pages/coordinator.html"
    },
    {
      "source": "/admin",
      "destination": "/pages/admin.html"
    },
    {
      "source": "/dashboard",
      "destination": "/pages/admin.html"
    },
    {
      "source": "/:path*",
      "destination": "/pages/index.html"
    }
  ],
  "headers": [
    {
      "source": "/js/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/supabase/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/pages/(.*).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(), geolocation=(self)"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Cross-Origin-Resource-Policy",
          "value": "same-site"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; connect-src 'self' https://kkbzofddkfusblyplnca.supabase.co https://*.supabase.co; script-src 'self' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://esm.sh https://www.gstatic.com; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; media-src 'self' https://www.karunya.edu; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
        }
      ]
    }
  ]
}
